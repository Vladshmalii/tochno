# Прод-секрети: скопіювати на сервер як /opt/docsai/.env (chmod 600).
# Домени, CORS і PUBLIC_API_URL зашиті в docker-compose.yml.
POSTGRES_PASSWORD=          # openssl rand -hex 24
SECRET_KEY=                 # openssl rand -hex 32
LLM_PROVIDER=openai         # mock — демо без ключа
OPENAI_API_KEY=
BOOTSTRAP_ADMIN_EMAIL=admin@tochno.app
BOOTSTRAP_ADMIN_PASSWORD=   # порожньо — згенерується і буде в логах api
ALLOW_SIGNUP=true
