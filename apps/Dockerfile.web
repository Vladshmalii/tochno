# Збірка SPA (client-web або admin-web) у статичний nginx.
#   docker build -f apps/Dockerfile.web --build-arg APP=client-web --build-arg VITE_API_URL=https://api.example.com .
FROM node:22-alpine AS build
ARG APP
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
WORKDIR /repo
COPY package.json package-lock.json ./
COPY apps/client-web/package.json apps/client-web/
COPY apps/admin-web/package.json apps/admin-web/
COPY packages/shared packages/shared
RUN npm ci
COPY apps/$APP apps/$APP
RUN npm run build -w @tochno/$APP

FROM nginx:1.27-alpine
ARG APP
COPY apps/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/$APP/dist /usr/share/nginx/html
EXPOSE 80
