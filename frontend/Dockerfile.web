# Збірка SPA (client-web або admin-web) у статичний nginx.
#   docker build -f frontend/Dockerfile.web --build-arg APP=client-web --build-arg VITE_API_URL=https://api.example.com .
FROM node:22-alpine AS build
ARG APP
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
WORKDIR /repo
COPY package.json package-lock.json ./
COPY frontend/client-web/package.json frontend/client-web/
COPY frontend/admin-web/package.json frontend/admin-web/
COPY frontend/shared frontend/shared
RUN npm ci
COPY frontend/$APP frontend/$APP
RUN npm run build -w @tochno/$APP

FROM nginx:1.27-alpine
ARG APP
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/frontend/$APP/dist /usr/share/nginx/html
EXPOSE 80
